<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Stage 51 Devil Android presentation theme.

        Presentation state is not constitutional state.

        Theme != authentication.
        Theme != authorization.
        Theme != runtime readiness.
        Theme != execution.
        Theme != verification.
        Theme != Outcome.
    -->
    <style
        name="Theme.Devil"
        parent="android:style/Theme.Material.NoActionBar">

        <item name="android:windowBackground">#050505</item>
        <item name="android:colorAccent">#E10600</item>
        <item name="android:navigationBarColor">#050505</item>
        <item name="android:statusBarColor">#050505</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

    </style>

    <!--
        Android system-owned cold-launch presentation.

        This intentionally uses a splash-specific Devil foreground rather
        than the adaptive launcher foreground because those two Android
        surfaces apply different geometry.

        Splash icon != authentication.
        Splash completion != runtime readiness.
        Splash completion != verified Outcome.
    -->
    <style
        name="Theme.Devil.Starting"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">#050505</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/devil_splash_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Devil</item>

    </style>

</resources>
